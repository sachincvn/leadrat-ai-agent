# ---------- App ----------
APP_NAME=MUSO AI
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ---------- LLM provider: huggingface | ollama | local_hf ----------
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# local open-source model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# hosted open-source model (Hugging Face Inference API) -- no local GPU needed
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen3-8B

# same weights loaded in-process with transformers (needs ~16 GB VRAM, or ~6 GB with 4-bit)
LOCAL_HF_MODEL=Qwen/Qwen3-8B
LOCAL_HF_LOAD_4BIT=false

# ---------- Agent ----------
AGENT_MAX_STEPS=3

# ---------- Leadrat CRM ----------
# The caller's JWT and tenant come from request headers, never from here.
LEADRAT_BASE_URL=https://connect.leadrat.info/api/v1/mcp
LEADRAT_TIMEOUT=60


# ---------- UI ----------
API_URL=http://localhost:8000
