# ---------- App ----------
APP_NAME=MUSO AI
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ---------- LLM provider: huggingface | mistral ----------
LLM_PROVIDER=mistral
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# Qwen on the Hugging Face router
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Mistral La Plateforme. The free tier serves ministral-8b-latest; the small
# and medium models need a paid tier and answer 403 tier_not_allowed without it.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest

# ---------- Agent ----------
AGENT_MAX_STEPS=3

# ---------- Leadrat CRM ----------
# The caller's JWT and tenant come from request headers, never from here.
LEADRAT_BASE_URL=https://connect.leadrat.info/api/v1/mcp
LEADRAT_TIMEOUT=60


# ---------- UI ----------
API_URL=http://localhost:8000
