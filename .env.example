# ---------- App ----------
APP_NAME=MUSO AI
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ---------- LLM provider: huggingface | ollama | local_hf ----------
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# local open-source model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# hosted open-source model (Hugging Face Inference API) -- no local GPU needed
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen3-8B

# same weights loaded in-process with transformers (needs ~16 GB VRAM, or ~6 GB with 4-bit)
LOCAL_HF_MODEL=Qwen/Qwen3-8B
LOCAL_HF_LOAD_4BIT=false

# ---------- Agent ----------
AGENT_MAX_STEPS=3

# ---------- Leadrat CRM ----------
LEADRAT_BASE_URL=https://connect.leadrat.info
LEADRAT_TIMEOUT=60

# Tenant header. Leave empty to take it from the JWT's custom:tenant_id claim.
LEADRAT_TENANT=

# Dev-only fallback JWT, used when a request carries no Authorization header.
# Leave empty in any shared environment — real requests must send their own token.
LEADRAT_JWT=

# ---------- UI ----------
API_URL=http://localhost:8000
